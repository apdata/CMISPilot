<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="CMISPilot"
           Manufacturer="AP-DATA"
           Version="$(var.ProductVersion)"
           UpgradeCode="65c2ffed-fc56-42ba-9c3f-357ac2644545"
           Language="1033"
           Scope="perMachine">

    <SummaryInformation Description="CMISPilot Installer" />

    <MajorUpgrade DowngradeErrorMessage="Es ist bereits eine neuere Version von CMISPilot installiert." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="CMISPilotIcon" SourceFile="$(var.PublishDir)\CMISPilot.Desktop.exe" />
    <Property Id="ARPPRODUCTICON" Value="CMISPilotIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/apdata/CMISPilot" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CMISPilot" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="CMISPilot" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcutStartMenu" Guid="3a6f6f5e-0e5b-4a3a-9a2d-6a2a0f7b8c11">
        <Shortcut Id="StartMenuShortcut"
                  Name="CMISPilot"
                  Description="CMISPilot – Werkbank fuer CMIS-Repositories"
                  Target="[INSTALLFOLDER]CMISPilot.Desktop.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                        Key="Software\AP-DATA\CMISPilot"
                        Name="StartMenuShortcutInstalled"
                        Type="integer"
                        Value="1"
                        KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="CMISPilot" Level="1">
      <ComponentRef Id="ApplicationShortcutStartMenu" />
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

  </Package>
</Wix>
