<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-windows statt net10.0 seit den PluginLoader-Tests (P2.6a): die
         referenzieren CMISPilot.Desktop, das WPF-spezifisch net10.0-windows
         zielt. UseWPF bleibt bewusst aus - dieses Projekt selbst braucht kein WPF. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="NSubstitute" Version="5.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CMISPilot.Cmis\CMISPilot.Cmis.csproj" />
    <ProjectReference Include="..\CMISPilot.ViewModels\CMISPilot.ViewModels.csproj" />
    <!-- PluginLoader-Tests (P2.6a): der Loader selbst braucht kein WPF, liegt aber
         in CMISPilot.Desktop. -->
    <ProjectReference Include="..\CMISPilot.Desktop\CMISPilot.Desktop.csproj" />
    <ProjectReference Include="..\CMISPilot.Plugins.Abstractions\CMISPilot.Plugins.Abstractions.csproj" />
  </ItemGroup>

</Project>
